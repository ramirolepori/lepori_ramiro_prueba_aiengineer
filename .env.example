# Copiar a .env y completar. .env está ignorado por git. Ninguna variable es obligatoria:
# sin LLM_PROVIDER el agente corre en modo offline y responde citando los documentos.

# none (por defecto, sin LLM) | openai (cualquier API compatible con OpenAI) | anthropic
LLM_PROVIDER=none

# --- Modelo local con Ollama (ollama pull qwen2.5:3b). La clave puede quedar vacía. ---
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:3b
# LLM_API_KEY=

# Modelo de embeddings para el guardrail (ollama pull embeddinggemma). Sin esto, el guardrail usa solo reglas
# y n-gramas de caracteres. Con OpenAI, por ejemplo, text-embedding-3-small.
# EMBEDDING_MODEL=embeddinggemma

# --- OpenAI (u otra API compatible: cambia solo la URL, el modelo y la clave) ---
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=<modelo>
# LLM_API_KEY=<clave>

# --- Anthropic ---
# LLM_PROVIDER=anthropic
# LLM_MODEL=<modelo>
# LLM_API_KEY=<clave>

# Tiempo máximo por llamada en segundos (un modelo local en CPU puede necesitar más) y tokens de salida
LLM_TIMEOUT_S=60
LLM_MAX_TOKENS=1024
