# Copiar a .env y completar. .env está ignorado por git. Ninguna variable es obligatoria:
# sin LLM_PROVIDER el agente corre en modo offline (reglas, n-gramas y BM25) y responde citando los documentos.

# none (por defecto, sin LLM) | openai (cualquier API compatible con OpenAI) | anthropic
LLM_PROVIDER=none

# --- Modelos locales con Ollama (ollama pull qwen2.5:7b y ollama pull embeddinggemma). La clave puede quedar vacía. ---
# Se escribe 127.0.0.1 y no localhost: en Windows localhost prueba primero IPv6 y cada llamada pierde unos 2 segundos
# (el cliente lo corrige solo, pero conviene dejarlo escrito así).
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen2.5:7b
# LLM_API_KEY=
# EMBEDDING_MODEL=embeddinggemma

# --- OpenAI (u otra API compatible: cambia solo la URL, el modelo y la clave) ---
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=<modelo>
# LLM_API_KEY=<clave>
# EMBEDDING_MODEL=text-embedding-3-small

# --- Anthropic (no ofrece embeddings: el guardrail y el RAG usan n-gramas y BM25) ---
# LLM_PROVIDER=anthropic
# LLM_MODEL=<modelo>
# LLM_API_KEY=<clave>

# Modelo de embeddings: lo usan el guardrail (significado de la pregunta) y el recuperador de documentos.
# Sin EMBEDDING_MODEL se usan solo reglas, n-gramas de caracteres y BM25.

# Caché en disco de los embeddings de textos fijos (documentos y frases de ejemplo), para que el arranque no los
# pida de nuevo. Nunca guarda preguntas de clientes. Por defecto .cache/ ; "none" la desactiva.
# EMBEDDINGS_CACHE=none

# Tiempo máximo por llamada en segundos (un modelo local en CPU puede necesitar más) y tokens de salida
LLM_TIMEOUT_S=60
LLM_MAX_TOKENS=1024
