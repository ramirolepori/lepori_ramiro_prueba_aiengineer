# Copiar a .env y completar. .env está ignorado por git. Sin clave el agente corre en modo offline.

# none (por defecto, sin LLM) | openai (cualquier API compatible con OpenAI) | anthropic
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=

# Solo para LLM_PROVIDER=openai. Ejemplos:
#   OpenAI:  https://api.openai.com/v1
#   Ollama:  http://localhost:11434/v1   (la clave puede quedar vacía)
#   Gemini:  https://generativelanguage.googleapis.com/v1beta/openai/
LLM_BASE_URL=

LLM_TIMEOUT_S=60
